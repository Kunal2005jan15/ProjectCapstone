# ---- Live DB integration -------------------------------------------------
# Paste in the Render Postgres connection string:
#   Render Dashboard -> your Postgres instance -> Connections
#   Use "External Database URL" if the ml-service runs outside Render's
#   network (e.g. locally); use "Internal Database URL" if it's deployed as
#   another Render service in the same region (faster, no SSL needed).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Backend push -----------------------------------------------------
# Base URL of the Spring Boot backend (Render web service URL in production,
# http://localhost:8080 for local testing).
BACKEND_BASE_URL=http://localhost:8080

# Shared secret for the ML service to authenticate its forecast pushes.
# Sent as the X-ML-Service-Key header (not Authorization: Bearer — kept
# separate from real user JWTs on purpose). MUST match ML_PUSH_API_KEY set
# on the backend (see backend/.env.example).
# Generate a random 32+ char value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_PUSH_AUTH_TOKEN=

# ---- CORS (for the admin dashboard's live "Demand Forecast" test page) ----
# Comma-separated list of allowed origins, e.g.:
#   ML_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Defaults to "*" (allow all) if unset — fine for local dev, set explicitly
# in production.
ML_CORS_ALLOWED_ORIGINS=
