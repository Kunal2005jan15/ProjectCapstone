# Copy to .env (or export as real environment variables) before running the app.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_platform
DB_USERNAME=food_platform_user
DB_PASSWORD=change_me

# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_BASE64_SECRET_BEFORE_DEPLOYING_TO_PRODUCTION

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL of the FastAPI + Prophet ML microservice (lives at ml-service/ in this same repo)
ML_SERVICE_URL=http://localhost:8000

# Shared secret the ml-service presents (as the X-ML-Service-Key header) when
# pushing forecasts. Must match ML_PUSH_AUTH_TOKEN in ml-service/.env.
# Leave blank to keep POST /api/v1/shops/{shopId}/forecasts OWNER/ADMIN-only
# (i.e. this integration is opt-in — blank = current behavior, unchanged).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_PUSH_API_KEY=

# Payment provider switch: "off" (default, Razorpay not available yet - checkout
# completes without a real payment step) or "razorpay" (requires the keys below).
PAYMENT_PROVIDER=off

# Only needed when PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
